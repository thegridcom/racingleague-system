<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<main class="flex-grow py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
  <div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/[0.04] border border-white/10 text-xs font-semibold text-[#DE382B] mb-2">
        <i class="fas fa-flag-checkered text-[#DE382B]"></i>
        <span>Offizielle Startaufstellung</span>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-white">Fahrerfeld &amp; Startnummern</h1>
      <p class="text-sm text-slate-400 mt-1">Alle registrierten Stamm- und Ersatzpiloten der Meisterschaft</p>
    </div>
    
    <% if (locals.user) { %>
      <a href="/driver/dashboard" class="px-5 py-2.5 rounded-full bg-white/10 border border-white/15 hover:bg-white/15 hover:border-white/25 text-xs text-white font-medium self-start sm:self-auto transition-all shadow-lg flex items-center gap-2">
        <i class="fas fa-gauge-high text-xs"></i>
        <span>Mein Cockpit aufrufen</span>
      </a>
    <% } %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    <% if (drivers && drivers.length > 0) { %>
      <% drivers.forEach((d) => { 
        // In der Renn-Startaufstellung gibt es ausschließlich Stammfahrer oder Ersatzfahrer (KEIN Admin-Badge im Fahrerfeld)
        const isStamm = (d.role === 'DRIVER') || (Boolean(d.teamId) && d.role !== 'RESERVE');
        const roleText = isStamm ? 'Stammfahrer' : 'Ersatzfahrer';
        const roleBadgeClass = isStamm
          ? 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30'
          : 'bg-cyan-500/15 text-cyan-300 border border-cyan-500/30';

        // Discord Avatar mit verifiziertem Fallback
        const avatarUrl = (d.discordAvatar && d.discordId)
          ? `https://cdn.discordapp.com/avatars/${d.discordId}/${d.discordAvatar}.png?size=128`
          : `https://cdn.discordapp.com/embed/avatars/${(d.discordId ? Number(BigInt(d.discordId) >> 22n) % 6 : 0)}.png`;

        // Menschlich lesbare Plattform-Bezeichnungen
        const platformMap = {
          'PC_STEAM': 'PC · Steam',
          'PC_EA': 'PC · EA App',
          'PC_EPIC': 'PC · Epic Games',
          'PC_XBOX': 'PC · Xbox App',
          'PLAYSTATION': 'PlayStation 5',
          'PS5': 'PlayStation 5',
          'XBOX': 'Xbox Series X/S',
          'PC': 'PC'
        };
        const platformLabel = (d.platform && platformMap[d.platform]) ? platformMap[d.platform] : (d.platform || 'Nicht angegeben');
      %>
        <div class="bg-slate-900/60 backdrop-blur-xl border border-white/10 rounded-2xl p-5 hover:border-white/20 hover:-translate-y-1 transition-all shadow-xl relative overflow-hidden group">
          
          <!-- Team Color Accent Bar on Left -->
          <div class="absolute left-0 top-0 bottom-0 w-1.5" style="background-color: <%= d.team ? d.team.colorHex : '#94A3B8' %>;"></div>

          <div class="flex items-start justify-between gap-3 mb-3.5 pl-2">
            <div class="flex items-center gap-3 min-w-0">
              
              <!-- Discord Profilbild -->
              <div class="relative flex-shrink-0">
                <img 
                  src="<%= avatarUrl %>" 
                  alt="<%= d.discordUsername %>" 
                  class="w-12 h-12 rounded-xl object-cover border border-white/15 bg-slate-950 shadow-md flex-shrink-0"
                  onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'; this.onerror=null;"
                >
              </div>

              <!-- Startnummer-Box im Motorsport-Look -->
              <div class="w-11 h-12 rounded-xl bg-slate-950/80 border border-white/10 group-hover:border-[#DE382B] transition-colors flex flex-col items-center justify-center font-mono flex-shrink-0 shadow-inner">
                <span class="text-[8px] text-slate-400 font-bold -mb-0.5 tracking-wider">CAR</span>
                <span class="text-base font-black text-white tabular-nums"><%= d.raceNumber ?? '—' %></span>
              </div>

              <!-- Fahrer-Identität & Handles -->
              <div class="min-w-0">
                <h3 class="text-base font-bold text-white group-hover:text-red-400 transition-colors truncate">
                  <%= d.platformUsername || d.gamertag || d.discordUsername %>
                </h3>
                <div class="text-[11px] text-slate-400 flex items-center gap-2 flex-wrap">
                  <span class="truncate">Discord: <span class="text-slate-200">@<%= d.discordUsername %></span></span>
                  <% if (d.eaId) { %>
                    <span class="text-amber-400 font-mono text-[10px] select-all font-semibold">EA: <%= d.eaId %></span>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- Role Badge: Ausschließlich Stammfahrer oder Ersatzfahrer (KEIN Admin) -->
            <span class="px-3 py-1 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider flex-shrink-0 <%= roleBadgeClass %>">
              <%= roleText %>
            </span>
          </div>

          <div class="pl-2 pt-3 border-t border-white/10 grid grid-cols-2 gap-2 text-xs">
            <div>
              <span class="text-[10px] font-mono uppercase text-slate-400 block mb-0.5">Team</span>
              <span class="font-medium text-white truncate flex items-center gap-1.5">
                <% if (d.team) { %>
                  <% if (d.team.logoUrl && d.team.logoUrl.startsWith('<svg')) { %>
                    <span class="inline-block w-5 h-4 flex-shrink-0" style="color: <%= d.team.colorHex %>;"><%- d.team.logoUrl %></span>
                  <% } %>
                  <span style="color: <%= d.team.colorHex %>;"><%= d.team.shortCode %></span> <%= d.team.name %>
                <% } else { %>
                  <span class="text-slate-400 italic">Freier Fahrer</span>
                <% } %>
              </span>
            </div>

            <div>
              <span class="text-[10px] font-mono uppercase text-slate-400 block mb-0.5">Plattform</span>
              <span class="font-mono text-slate-300"><%= platformLabel %></span>
            </div>

            <% if (d.assists) { %>
              <div class="col-span-2 mt-1">
                <span class="text-[10px] font-mono uppercase text-slate-400 block mb-0.5">Fahrhilfen</span>
                <span class="text-slate-300 text-[11px]"><%= d.assists %></span>
              </div>
            <% } %>
          </div>

        </div>
      <% }); %>
    <% } else { %>
      <div class="col-span-full bg-slate-900/60 backdrop-blur-xl border border-white/10 rounded-2xl p-8 text-center text-xs text-slate-400">
        Noch keine Fahrer im System registriert.
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
