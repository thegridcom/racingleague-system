<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<main class="flex-grow py-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
  
  <div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="font-mono text-xs uppercase tracking-widest text-[#DE382B] font-semibold mb-1">
        Rennställe &amp; Cockpit-Management // F1 Saison 2026
      </div>
      <h1 class="text-3xl font-display font-black tracking-tight text-white">Team-Management</h1>
      <p class="text-sm text-slate-400 mt-1">
        Verwalte die Formel-1-Konstrukteure (inkl. Audi &amp; Cadillac). Lege neue Teams an und weise Fahrern Cockpits zu (max. 2 Stammfahrer pro Team).
      </p>
    </div>

    <div class="flex items-center gap-3">
      <a href="/admin/stewarding" class="text-xs text-amber-400 hover:text-amber-300 font-mono flex items-center gap-1 border border-amber-500/30 px-3 py-1.5 rounded bg-amber-500/10">
        ⚖️ Stewarding
      </a>
      <a href="/admin" class="text-xs text-slate-400 hover:text-white font-mono flex items-center gap-1">
        ← Admin-Zentrale
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8">
    
    <!-- 1. Neues Team anlegen -->
    <div class="lg:col-span-5 bg-slate-900/60 backdrop-blur-xl border border-white/10 shadow-xl rounded-2xl p-6">
      <div class="flex items-center gap-2 mb-4">
        <div class="w-2.5 h-2.5 rounded-full bg-[#DE382B]"></div>
        <h3 class="text-base font-display font-bold text-white">Neues Rennteam anlegen</h3>
      </div>

      <form action="/admin/teams/create" method="POST" class="space-y-4 text-xs">
        <div>
          <label class="block text-slate-400 font-mono mb-1">Team-Name (Vollständig)</label>
          <input 
            type="text" 
            name="name" 
            required 
            placeholder="z. B. Porsche Motorsport F1" 
            class="w-full px-3 py-2 rounded bg-slate-950/80 border border-white/10 shadow-inner text-white focus:outline-none focus:border-[#DE382B]"
          >
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 font-mono mb-1">Kürzel (3–5 Zeichen)</label>
            <input 
              type="text" 
              name="shortCode" 
              required 
              maxlength="5"
              placeholder="POR" 
              class="w-full px-3 py-2 rounded bg-slate-950/80 border border-white/10 shadow-inner text-white font-mono uppercase focus:outline-none focus:border-[#DE382B]"
            >
          </div>
          <div>
            <label class="block text-slate-400 font-mono mb-1">Haupt-Teamfarbe</label>
            <div class="flex items-center gap-2">
              <input 
                type="color" 
                name="colorHex" 
                value="#DE382B" 
                class="w-9 h-8 p-0 rounded bg-transparent border-0 cursor-pointer"
                onchange="document.getElementById('color-hex-text').value = this.value"
              >
              <input 
                type="text" 
                id="color-hex-text" 
                name="colorHexText" 
                value="#DE382B" 
                class="w-full px-2 py-1.5 rounded bg-slate-950/80 border border-white/10 shadow-inner text-white font-mono uppercase text-[11px]"
                onchange="this.previousElementSibling.value = this.value"
              >
            </div>
          </div>
        </div>

        <div>
          <label class="block text-slate-400 font-mono mb-1">Logo / SVG (Optional)</label>
          <input 
            type="text" 
            name="logoUrl" 
            placeholder="URL zum Teamlogo oder SVG Code" 
            class="w-full px-3 py-2 rounded bg-slate-950/80 border border-white/10 shadow-inner text-white focus:outline-none focus:border-[#DE382B]"
          >
        </div>

        <button type="submit" class="w-full py-2.5 rounded bg-[#DE382B] hover:bg-[#C52B1F] text-white font-semibold transition-colors">
          Rennteam hinzufügen
        </button>
      </form>
    </div>

    <!-- 2. Fahrer einem Team zuweisen -->
    <div class="lg:col-span-7 bg-slate-900/60 backdrop-blur-xl border border-white/10 shadow-xl rounded-2xl p-6">
      <div class="flex items-center gap-2 mb-4">
        <div class="w-2.5 h-2.5 rounded-full bg-cyan-400"></div>
        <h3 class="text-base font-display font-bold text-white">Cockpit-Zuweisung</h3>
      </div>

      <form action="/admin/teams/assign" method="POST" class="space-y-4 text-xs">
        <div>
          <label class="block text-slate-400 font-mono mb-1">Freier Fahrer</label>
          <select name="userId" required class="w-full px-3 py-2 rounded bg-slate-950/80 border border-white/10 shadow-inner text-white focus:outline-none focus:border-[#DE382B]">
            <option value="">-- Fahrer auswählen --</option>
            <% unassignedDrivers.forEach(d => { %>
              <option value="<%= d.id %>">
                <%= d.gamertag || d.discordUsername %> (<%= d.platform ?? 'Keine Plattform' %>, #<%= d.raceNumber ?? '?' %>)
              </option>
            <% }) %>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 font-mono mb-1">Ziel-Team</label>
            <select name="teamId" required class="w-full px-3 py-2 rounded bg-slate-950/80 border border-white/10 shadow-inner text-white focus:outline-none focus:border-[#DE382B]">
              <option value="">-- Team wählen --</option>
              <% teams.forEach(t => { 
                const mainCount = t.drivers.filter(d => d.role === 'DRIVER').length;
              %>
                <option value="<%= t.id %>" <%= mainCount >= 2 ? 'data-full="true"' : '' %>>
                  <%= t.name %> (<%= t.shortCode %>) - <%= mainCount %>/2 Stamm
                </option>
              <% }) %>
            </select>
          </div>

          <div>
            <label class="block text-slate-400 font-mono mb-1">Rolle im Team</label>
            <select name="role" class="w-full px-3 py-2 rounded bg-slate-950/80 border border-white/10 shadow-inner text-white focus:outline-none focus:border-[#DE382B]">
              <option value="DRIVER">Stammfahrer (Max. 2)</option>
              <option value="RESERVE">Ersatzfahrer (Reserve)</option>
            </select>
          </div>
        </div>

        <button type="submit" class="w-full py-2.5 rounded bg-neutral-800 hover:bg-neutral-700 text-white font-semibold transition-colors">
          Cockpit zuweisen
        </button>
      </form>
    </div>

  </div>

  <!-- Teams Grid (Alle 2026 Teams) -->
  <div class="mb-4 flex items-center justify-between">
    <h3 class="text-base font-display font-bold text-white">
      Gemeldete Rennställe (<%= teams.length %> Teams)
    </h3>
    <span class="text-xs text-slate-400 font-mono">
      F1 Saison 2026 Grid
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% teams.forEach((t) => { 
      const mainDrivers = t.drivers.filter(d => d.role === 'DRIVER');
      const reserveDrivers = t.drivers.filter(d => d.role === 'RESERVE');
    %>
      <div class="bg-slate-900/60 backdrop-blur-xl border border-white/10 shadow-xl rounded-2xl overflow-hidden relative flex flex-col justify-between hover:border-neutral-600 transition-colors shadow-lg">
        
        <!-- Team Color Banner -->
        <div class="h-2.5 w-full" style="background-color: <%= t.colorHex %>;"></div>

        <div class="p-5 flex-grow">
          <div class="flex items-start justify-between gap-3 mb-4">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="px-2 py-0.5 rounded text-xs font-mono font-black" style="background-color: <%= t.colorHex %>20; color: <%= t.colorHex %>; border: 1px solid <%= t.colorHex %>40;">
                  <%= t.shortCode %>
                </span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-950/80 border border-white/10 shadow-inner <%= mainDrivers.length === 2 ? 'text-emerald-400' : 'text-amber-400' %>">
                  <%= mainDrivers.length %>/2 Stamm
                </span>
              </div>
              <h3 class="text-base font-display font-bold text-white"><%= t.name %></h3>
            </div>

            <!-- Team Logo Badge -->
            <div class="w-12 h-10 rounded bg-slate-950/80 border border-white/10 shadow-inner flex items-center justify-center p-1.5 flex-shrink-0" style="color: <%= t.colorHex %>;">
              <% if (t.logoUrl && t.logoUrl.startsWith('<svg')) { %>
                <%- t.logoUrl %>
              <% } else if (t.logoUrl) { %>
                <img src="<%= t.logoUrl %>" alt="<%= t.shortCode %>" class="max-h-full max-w-full object-contain">
              <% } else { %>
                <span class="font-mono font-bold text-xs"><%= t.shortCode %></span>
              <% } %>
            </div>
          </div>

          <!-- Stammfahrer Cockpits -->
          <div class="space-y-2 mb-4">
            <span class="text-[10px] font-mono uppercase text-slate-400 font-bold block">
              Stammfahrer-Cockpits:
            </span>

            <% for (let i = 0; i < 2; i++) { 
              const d = mainDrivers[i];
            %>
              <div class="p-2.5 rounded-lg bg-slate-950/80 border border-white/10 shadow-inner flex items-center justify-between text-xs">
                <% if (d) { %>
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-mono font-bold text-slate-300">#<%= d.raceNumber ?? '—' %></span>
                    <span class="font-semibold text-white"><%= d.platformUsername || d.gamertag || d.discordUsername %></span>
                    <% if (d.eaId) { %>
                      <span class="text-[10px] text-amber-400 font-mono">EA: <%= d.eaId %></span>
                    <% } %>
                    <span class="text-[10px] text-slate-400 font-mono">(<%= d.platform %>)</span>
                  </div>

                  <form action="/admin/teams/remove" method="POST" class="inline">
                    <input type="hidden" name="userId" value="<%= d.id %>">
                    <button type="submit" title="Fahrer entfernen" class="text-rose-400 hover:text-rose-300 text-xs font-medium">
                      Freistellen
                    </button>
                  </form>
                <% } else { %>
                  <div class="text-neutral-500 italic flex items-center gap-2 text-[11px]">
                    <span class="w-1.5 h-1.5 rounded-full bg-neutral-600"></span>
                    <span>Freies Cockpit <%= i + 1 %></span>
                  </div>
                <% } %>
              </div>
            <% } %>
          </div>

          <!-- Ersatzfahrer -->
          <% if (reserveDrivers.length > 0) { %>
            <div class="pt-3 border-t border-white/10">
              <span class="text-[10px] font-mono uppercase text-slate-400 font-bold block mb-1.5">
                Ersatzfahrer:
              </span>
              <div class="space-y-1.5">
                <% reserveDrivers.forEach(rd => { %>
                  <div class="p-2 rounded bg-slate-950/80/60 border border-[#1A202D] flex items-center justify-between text-xs text-slate-300">
                    <div class="flex items-center gap-2">
                      <span class="font-mono text-slate-400">#<%= rd.raceNumber ?? '-' %></span>
                      <span><%= rd.gamertag || rd.discordUsername %></span>
                    </div>
                    <form action="/admin/teams/remove" method="POST" class="inline">
                      <input type="hidden" name="userId" value="<%= rd.id %>">
                      <button type="submit" class="text-[11px] text-slate-400 hover:text-rose-400">
                        Entfernen
                      </button>
                    </form>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>

        </div>

        <!-- Team Footer mit Lösch-Möglichkeit -->
        <div class="p-3 bg-slate-950/80 border-t border-white/10 flex items-center justify-between text-xs">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full" style="background-color: <%= t.colorHex %>;"></div>
            <span class="font-mono text-[11px] text-slate-400"><%= t.colorHex %></span>
          </div>

          <form action="/admin/teams/delete" method="POST" class="inline" onsubmit="return confirm('Möchtest du dieses Team wirklich löschen?')">
            <input type="hidden" name="teamId" value="<%= t.id %>">
            <button type="submit" class="text-neutral-500 hover:text-rose-400 transition-colors text-[11px] font-mono">
              Team löschen
            </button>
          </form>
        </div>

      </div>
    <% }); %>
  </div>

</main>

<%- include('../partials/footer') %>
