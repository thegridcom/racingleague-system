<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<main class="flex-grow py-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
  
  <!-- Back Link & Admin Trigger -->
  <div class="flex items-center justify-between mb-6">
    <a href="/calendar" class="text-xs text-slate-400 hover:text-white flex items-center gap-1.5 font-mono transition-colors">
      <i class="fas fa-arrow-left text-[10px]"></i>
      <span>Zurück zum Rennkalender</span>
    </a>

    <% if (locals.user && locals.user.role === 'ADMIN') { %>
      <div class="flex items-center gap-2">
        <a href="/admin/races/<%= race.id %>/results" class="px-4 py-2 rounded-xl bg-amber-500/20 border border-amber-500/40 text-amber-300 hover:bg-amber-500/30 text-xs font-mono font-semibold transition-all flex items-center gap-1.5 shadow-lg">
          <i class="fas fa-gear text-xs"></i>
          <span>Ergebnisse eintragen / bearbeiten</span>
        </a>
      </div>
    <% } %>
  </div>

  <!-- Race Hero Card im thegridcom.org Glassmorphism-Look -->
  <div class="bg-slate-900/60 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sm:p-8 mb-8 relative overflow-hidden shadow-2xl">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
      
      <div class="flex items-center gap-5">
        <div class="w-20 h-20 rounded-2xl bg-slate-950/80 border border-white/10 flex items-center justify-center text-4xl shadow-lg flex-shrink-0">
          <%= race.flagEmoji %>
        </div>

        <div>
          <div class="flex items-center gap-2 mb-1 flex-wrap">
            <span class="font-mono text-xs uppercase text-[#DE382B] font-bold tracking-wider">
              Runde <%= race.roundNumber %> // <%= race.season.name %>
            </span>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase <%= race.status === 'COMPLETED' ? 'bg-white/10 text-slate-300' : 'bg-emerald-500/20 text-emerald-300' %>">
              <%= race.status === 'COMPLETED' ? 'Beendet' : 'Anstehend' %>
            </span>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase bg-[#DE382B]/15 border border-[#DE382B]/30 text-red-300">
              50% Renndistanz
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-bold text-white">
            <%= race.trackName %>
          </h1>
          <p class="text-xs text-slate-400 mt-1">
            <%= race.country %> · Startzeit: <strong class="text-white font-mono"><%= new Date(race.date).toLocaleString('de-DE', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %> Uhr</strong>
          </p>
        </div>
      </div>

      <!-- Quick Attendance Stats -->
      <div class="flex items-center gap-3">
        <div class="px-4 py-2.5 rounded-xl bg-slate-950/70 border border-white/10 text-center shadow-inner">
          <span class="text-[10px] font-mono uppercase text-emerald-400 font-bold block">🟢 Zugesagt</span>
          <span class="text-lg font-mono font-bold text-white"><%= counts.attending %> / 20</span>
        </div>
        <div class="px-4 py-2.5 rounded-xl bg-slate-950/70 border border-white/10 text-center shadow-inner">
          <span class="text-[10px] font-mono uppercase text-rose-400 font-bold block">🔴 Abgemeldet</span>
          <span class="text-lg font-mono font-bold text-white"><%= counts.absent %></span>
        </div>
        <div class="px-4 py-2.5 rounded-xl bg-slate-950/70 border border-white/10 text-center shadow-inner">
          <span class="text-[10px] font-mono uppercase text-amber-400 font-bold block">🟡 Reserve</span>
          <span class="text-lg font-mono font-bold text-white"><%= counts.reserve %></span>
        </div>
      </div>

    </div>
  </div>

  <!-- Circuit Map & Technical Data Showcase -->
  <div class="bg-slate-900/60 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sm:p-8 mb-8 relative overflow-hidden shadow-2xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Vector Track Layout SVG -->
      <div class="lg:col-span-7 flex flex-col items-center justify-center bg-slate-950/70 p-6 rounded-2xl border border-white/10 relative shadow-inner">
        <div class="w-full h-56 flex items-center justify-center">
          <% if (race.trackLayoutSvg) { %>
            <svg viewBox="0 0 400 300" class="w-full h-full stroke-red-500 fill-none drop-shadow-[0_0_12px_rgba(222,56,43,0.45)]" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
              <path d="<%= race.trackLayoutSvg %>" />
              <circle cx="100" cy="220" r="6" class="fill-white stroke-black" stroke-width="2" />
            </svg>
          <% } else { %>
            <div class="text-slate-400 font-mono text-xs">Streckengrafik in Vorbereitung</div>
          <% } %>
        </div>

        <div class="w-full flex items-center justify-between text-[11px] font-mono text-slate-400 border-t border-white/5 pt-3 mt-2">
          <span>● Start/Ziel-Linie</span>
          <span>F1 2026 Grand Prix Circuit</span>
          <span>DRS Zonen: 2–3</span>
        </div>
      </div>

      <!-- Technical Circuit Data -->
      <div class="lg:col-span-5 space-y-4">
        <div>
          <span class="font-mono text-[10px] uppercase text-[#DE382B] font-bold tracking-widest block mb-1">Circuit Telemetrie &amp; Spezifikationen</span>
          <h3 class="text-xl font-bold text-white"><%= race.trackName %></h3>
          <p class="text-xs text-slate-400 mt-1">Offizielle Grand-Prix-Streckenführung für die FIA Meisterschaft 2026.</p>
        </div>

        <div class="grid grid-cols-2 gap-3 text-xs">
          <div class="p-3.5 rounded-xl bg-slate-950/70 border border-white/10 shadow-inner">
            <span class="text-slate-400 font-mono block text-[10px] uppercase mb-0.5">Streckenlänge</span>
            <span class="font-mono font-bold text-base text-white"><%= race.lengthKm ?? '5.412' %> km</span>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-950/70 border border-white/10 shadow-inner">
            <span class="text-slate-400 font-mono block text-[10px] uppercase mb-0.5">Renndistanz</span>
            <span class="font-mono font-bold text-base text-white"><%= race.laps ?? '29' %> Runden (50%)</span>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-950/70 border border-white/10 shadow-inner">
            <span class="text-slate-400 font-mono block text-[10px] uppercase mb-0.5">Gesamtdistanz (50%)</span>
            <span class="font-mono font-bold text-sm text-slate-200">
              <%= race.lengthKm && race.laps ? (race.lengthKm * race.laps).toFixed(1) + ' km' : 'ca. 155 km' %>
            </span>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-950/70 border border-white/10 shadow-inner">
            <span class="text-slate-400 font-mono block text-[10px] uppercase mb-0.5">Reglement</span>
            <span class="font-mono font-bold text-sm text-amber-400">50% Liga-Format</span>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Interactive Check-In Box for Logged In Drivers -->
  <% if (race.status !== 'COMPLETED') { %>
    <div class="bg-slate-900/60 backdrop-blur-xl border border-white/10 rounded-2xl p-6 mb-8 shadow-xl">
      <h3 class="text-base font-bold text-white mb-2 flex items-center gap-2">
        <i class="fas fa-check-to-slot text-[#DE382B]"></i>
        <span>Deine Rückmeldung für dieses Rennen</span>
      </h3>
      
      <% if (locals.user) { 
        const myStatus = userAttendance ? userAttendance.status : null;
      %>
        <form action="/attendance/checkin" method="POST" class="space-y-4">
          <input type="hidden" name="raceId" value="<%= race.id %>">
          <input type="hidden" name="returnTo" value="/races/<%= race.id %>">

          <div class="flex flex-wrap items-center gap-3">
            <label class="cursor-pointer">
              <input type="radio" name="status" value="ATTENDING" class="peer sr-only" <%= myStatus === 'ATTENDING' ? 'checked' : '' %>>
              <div class="px-4 py-2.5 rounded-xl bg-slate-950/80 border border-white/10 peer-checked:border-emerald-500 peer-checked:bg-emerald-500/20 text-xs font-bold text-slate-300 peer-checked:text-emerald-300 transition-all">
                🟢 Bin dabei (Teilnahme)
              </div>
            </label>

            <label class="cursor-pointer">
              <input type="radio" name="status" value="ABSENT" class="peer sr-only" <%= myStatus === 'ABSENT' ? 'checked' : '' %>>
              <div class="px-4 py-2.5 rounded-xl bg-slate-950/80 border border-white/10 peer-checked:border-rose-500 peer-checked:bg-rose-500/20 text-xs font-bold text-slate-300 peer-checked:text-rose-300 transition-all">
                🔴 Kann nicht (Abmeldung)
              </div>
            </label>

            <label class="cursor-pointer">
              <input type="radio" name="status" value="RESERVE" class="peer sr-only" <%= myStatus === 'RESERVE' ? 'checked' : '' %>>
              <div class="px-4 py-2.5 rounded-xl bg-slate-950/80 border border-white/10 peer-checked:border-amber-500 peer-checked:bg-amber-500/20 text-xs font-bold text-slate-300 peer-checked:text-amber-300 transition-all">
                🟡 Reserve / Unsicher
              </div>
            </label>
          </div>

          <div class="flex items-center gap-3">
            <input 
              type="text" 
              name="notes" 
              value="<%= userAttendance ? userAttendance.notes || '' : '' %>"
              placeholder="Optionale Notiz (z. B. 'komme 10 Min später')" 
              class="max-w-md w-full px-3.5 py-2.5 rounded-xl bg-slate-950/80 border border-white/10 text-white text-xs focus:outline-none focus:border-white/25"
            >
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-[#DE382B] hover:bg-[#C52B1F] text-xs font-semibold text-white transition-all shadow-lg hover:-translate-y-0.5">
              Status speichern
            </button>
          </div>
        </form>
      <% } else { %>
        <p class="text-xs text-slate-400 mb-3">
          Bitte melde dich mit deinem Discord-Account an, um deine An- oder Abmeldung für diesen Renntag zu erfassen.
        </p>
        <a href="/auth/login" class="px-5 py-2.5 rounded-xl bg-[#5865F2] hover:bg-[#4752C4] text-xs font-semibold text-white inline-flex items-center gap-2 shadow-lg transition-all hover:-translate-y-0.5">
          <i class="fab fa-discord"></i> Anmelden zum Check-In
        </a>
      <% } %>
    </div>
  <% } %>

  <!-- If Race is COMPLETED: Rennergebnisse Tabelle -->
  <% if (race.status === 'COMPLETED' && race.results.length > 0) { %>
    <div class="bg-slate-900/60 backdrop-blur-xl border border-white/10 rounded-2xl overflow-hidden mb-12 shadow-2xl">
      <div class="p-5 border-b border-white/10 flex items-center justify-between">
        <div>
          <span class="text-[10px] font-mono uppercase text-[#DE382B] font-bold tracking-wider">Offizielle Wertung</span>
          <h2 class="text-lg font-bold text-white">Rennergebnis</h2>
        </div>
        <a href="/standings" class="text-xs text-slate-400 hover:text-white transition-colors">Zur Gesamtwertung →</a>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-950/80 text-slate-400 font-mono uppercase text-[10px] border-b border-white/5">
            <tr>
              <th class="px-4 py-3.5">Pos</th>
              <th class="px-4 py-3.5">Fahrer</th>
              <th class="px-4 py-3.5">Team</th>
              <th class="px-4 py-3.5">Schnellste Runde</th>
              <th class="px-4 py-3.5">Status</th>
              <th class="px-4 py-3.5 text-right">Punkte</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            <% race.results.forEach((r) => { %>
              <tr class="hover:bg-white/[0.03] transition-colors">
                <td class="px-4 py-3.5 font-mono font-bold text-sm <%= r.position === 1 ? 'text-amber-400' : r.position <= 3 ? 'text-slate-200' : 'text-slate-400' %>">
                  <%= r.position %>
                </td>
                <td class="px-4 py-3.5 font-semibold text-white">
                  <%= r.driverName %>
                </td>
                <td class="px-4 py-3.5 text-slate-300"><%= r.teamName %></td>
                <td class="px-4 py-3.5 font-mono">
                  <% if (r.fastestLap) { %>
                    <span class="text-purple-400 font-bold">⚡ <%= r.fastestLapTime || 'FL' %> (+1 Pt)</span>
                  <% } else { %>
                    <span class="text-slate-400">-</span>
                  <% } %>
                </td>
                <td class="px-4 py-3.5">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono <%= r.status === 'FINISHED' ? 'bg-emerald-950/40 text-emerald-300 border border-emerald-500/30' : 'bg-rose-950/40 text-rose-300 border border-rose-500/30' %>">
                    <%= r.status %>
                  </span>
                </td>
                <td class="px-4 py-3.5 text-right font-mono font-bold text-white tabular-nums text-sm">
                  <%= r.points %> PTS
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

  <!-- Teilnehmerliste & Anwesenheiten -->
  <div class="bg-slate-900/60 backdrop-blur-xl border border-white/10 rounded-2xl overflow-hidden mb-8 shadow-2xl">
    <div class="p-5 border-b border-white/10 flex items-center justify-between">
      <div>
        <span class="text-[10px] font-mono uppercase text-slate-400 font-bold tracking-wider">Lobby-Planung</span>
        <h2 class="text-lg font-bold text-white">Aktuelle Anwesenheitsliste</h2>
      </div>

      <a href="/races/<%= race.id %>/attendance/export/csv" class="px-3.5 py-1.5 rounded-xl bg-white/10 border border-white/15 hover:bg-white/15 text-xs font-mono text-slate-300 hover:text-white transition-all flex items-center gap-1.5 shadow-sm">
        <i class="fas fa-file-csv text-slate-400"></i>
        <span>CSV Export</span>
      </a>
    </div>

    <% if (race.attendances.length === 0) { %>
      <div class="p-8 text-center text-xs text-slate-400">
        Bisher liegen noch keine Rückmeldungen für dieses Rennen vor.
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-950/80 text-slate-400 font-mono uppercase text-[10px] border-b border-white/5">
            <tr>
              <th class="px-4 py-3.5">Status</th>
              <th class="px-4 py-3.5">Fahrer / EA-ID (Einladung)</th>
              <th class="px-4 py-3.5">Startnr.</th>
              <th class="px-4 py-3.5">Plattform</th>
              <th class="px-4 py-3.5">Team</th>
              <th class="px-4 py-3.5">Notiz</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            <% race.attendances.forEach((a) => { %>
              <tr class="hover:bg-white/[0.03] transition-colors">
                <td class="px-4 py-3.5">
                  <% if (a.status === 'ATTENDING') { %>
                    <span class="px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-300 font-mono text-[10px] font-bold">
                      🟢 DABEi
                    </span>
                  <% } else if (a.status === 'ABSENT') { %>
                    <span class="px-2.5 py-1 rounded-full bg-rose-500/20 text-rose-300 font-mono text-[10px] font-bold">
                      🔴 ABGEMELDET
                    </span>
                  <% } else { %>
                    <span class="px-2.5 py-1 rounded-full bg-amber-500/20 text-amber-300 font-mono text-[10px] font-bold">
                      🟡 RESERVE
                    </span>
                  <% } %>
                </td>
                <td class="px-4 py-3.5">
                  <div class="font-semibold text-white">
                    <%= a.user.platformUsername || a.user.gamertag || a.user.discordUsername %>
                  </div>
                  <% if (a.user.eaId) { %>
                    <div class="text-[10px] font-mono text-amber-400 select-all font-semibold">
                      EA-ID: <%= a.user.eaId %>
                    </div>
                  <% } %>
                </td>
                <td class="px-4 py-3.5 font-mono text-slate-300">
                  <%= a.user.raceNumber ? '#' + a.user.raceNumber : '-' %>
                </td>
                <td class="px-4 py-3.5 font-mono text-slate-300 text-[11px]">
                  <span class="px-2 py-0.5 rounded-lg bg-black/40 border border-white/10">
                    <%= a.user.platform || 'PC' %>
                  </span>
                </td>
                <td class="px-4 py-3.5 text-slate-300">
                  <%= a.user.team ? a.user.team.name : 'Kein Team' %>
                </td>
                <td class="px-4 py-3.5 text-slate-400 italic">
                  <%= a.notes || '—' %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

</main>

<%- include('../partials/footer') %>
