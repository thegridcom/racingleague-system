<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<main class="flex-grow py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
  <div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/[0.04] border border-white/10 text-xs font-semibold text-[#DE382B] mb-2">
        <i class="fas fa-calendar-alt text-[#DE382B]"></i>
        <span>Offizieller Streckenkalender</span>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-white">
        <%= activeSeason ? activeSeason.name : 'Rennkalender' %>
      </h1>
      <div class="flex items-center gap-2.5 flex-wrap mt-1">
        <p class="text-sm text-slate-400">Alle Grand-Prix-Events der laufenden Meisterschaft</p>
        <span class="px-2.5 py-0.5 rounded-full bg-[#DE382B]/15 border border-[#DE382B]/30 text-[11px] font-mono text-red-300 font-semibold">50% Renndistanz</span>
      </div>
    </div>

    <!-- Saisonauswahl falls mehrere existieren -->
    <% if (allSeasons && allSeasons.length > 1) { %>
      <div class="flex items-center gap-2">
        <span class="text-xs text-slate-400 font-mono">Saison:</span>
        <select onchange="window.location.href='/calendar?seasonId=' + this.value" class="px-4 py-2 rounded-xl bg-slate-900/80 border border-white/10 text-xs text-white focus:outline-none focus:border-white/20">
          <% allSeasons.forEach(s => { %>
            <option value="<%= s.id %>" <%= activeSeason && activeSeason.id === s.id ? 'selected' : '' %>><%= s.name %></option>
          <% }) %>
        </select>
      </div>
    <% } %>
  </div>

  <% if (!activeSeason || !activeSeason.races || activeSeason.races.length === 0) { %>
    <div class="bg-slate-900/60 backdrop-blur-xl border border-white/10 rounded-2xl p-8 text-center text-xs text-slate-400">
      Noch keine Rennen für diese Saison eingetragen.
    </div>
  <% } else { %>
    <div class="space-y-4">
      <% activeSeason.races.forEach((race) => { 
        const isCompleted = race.status === 'COMPLETED';
        const isUpcoming = race.status === 'UPCOMING' || race.status === 'ACTIVE';
        const attendingCount = race.attendances?.filter(a => a.status === 'ATTENDING').length || 0;
      %>
        <div class="bg-slate-900/60 backdrop-blur-xl border border-white/10 rounded-2xl p-5 sm:p-6 hover:border-white/20 hover:-translate-y-0.5 transition-all shadow-xl flex flex-col md:flex-row md:items-center justify-between gap-4">
          
          <div class="flex items-center gap-4">
            <!-- Round Number Badge -->
            <div class="w-14 h-14 rounded-2xl bg-slate-950/80 border border-white/10 flex flex-col items-center justify-center font-mono flex-shrink-0 shadow-inner">
              <span class="text-[9px] uppercase font-bold text-slate-400 tracking-wider">RUNDE</span>
              <span class="text-xl font-black text-white tabular-nums"><%= race.roundNumber %></span>
            </div>

            <!-- Mini Track SVG Preview -->
            <% if (race.trackLayoutSvg) { %>
              <div class="w-16 h-12 hidden sm:flex items-center justify-center p-1.5 bg-slate-950/60 rounded-xl border border-white/10 flex-shrink-0 hover:border-red-500/50 transition-colors">
                <svg viewBox="0 0 400 300" class="w-full h-full stroke-slate-300 fill-none" stroke-width="7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="<%= race.trackLayoutSvg %>" />
                </svg>
              </div>
            <% } %>

            <div>
              <div class="flex items-center gap-2 mb-0.5">
                <span class="text-xl"><%= race.flagEmoji %></span>
                <h3 class="text-base font-bold text-white">
                  <%= race.trackName %>
                </h3>
              </div>
              <div class="text-xs text-slate-400 flex items-center gap-3 flex-wrap">
                <span><%= race.country %></span>
                <% if (race.lengthKm) { %>
                  <span>•</span>
                  <span class="font-mono text-slate-300"><%= race.lengthKm %> km (<%= race.laps %> Runden · 50% Distanz)</span>
                <% } %>
                <span>•</span>
                <span class="font-mono text-slate-300">
                  <%= new Date(race.date).toLocaleDateString('de-DE', { weekday: 'short', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %> Uhr
                </span>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-3 self-end md:self-center">
            <!-- Status Badge -->
            <% if (isCompleted) { %>
              <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-slate-400 text-xs font-mono font-medium">
                Beendet
              </span>
            <% } else { %>
              <span class="px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-mono font-medium flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                Check-In offen (<%= attendingCount %>)
              </span>
            <% } %>

            <a href="/races/<%= race.id %>" class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 border border-white/10 text-xs font-semibold text-white transition-all flex items-center gap-1.5">
              <span><%= isCompleted ? 'Ergebnisse ansehen' : 'Details & Anmelden' %></span>
              <i class="fas fa-arrow-right text-[10px]"></i>
            </a>
          </div>

        </div>
      <% }); %>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
