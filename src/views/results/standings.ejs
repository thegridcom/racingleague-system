<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<main class="flex-grow py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
  
  <!-- Header & Controls -->
  <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/[0.04] border border-white/10 text-xs font-semibold text-[#DE382B] mb-2">
        <i class="fas fa-trophy text-amber-400"></i>
        <span>Offizielle Meisterschaftswertung</span>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-white">
        <%= season ? season.name : 'Meisterschaftswertung' %>
      </h1>
      <p class="text-sm text-slate-400 mt-1">Punkteberechnung gemäß FIA F1-Punkteschema inkl. schnellste Rennrunde</p>
    </div>

    <!-- Export & Season Filter -->
    <div class="flex items-center gap-2.5 flex-wrap">
      <% if (allSeasons && allSeasons.length > 1) { %>
        <select onchange="window.location.href='/standings?seasonId=' + this.value" class="px-3.5 py-2 rounded-xl bg-slate-900/80 border border-white/10 text-xs text-white focus:outline-none">
          <% allSeasons.forEach(s => { %>
            <option value="<%= s.id %>" <%= season && season.id === s.id ? 'selected' : '' %>><%= s.name %></option>
          <% }) %>
        </select>
      <% } %>

      <!-- CSV Export Button -->
      <a href="/standings/export/csv<%= season ? '?seasonId=' + season.id : '' %>" class="px-3.5 py-2 rounded-xl bg-white/10 border border-white/15 hover:bg-white/15 text-xs font-mono text-slate-300 hover:text-white transition-all flex items-center gap-1.5 shadow-sm">
        <i class="fas fa-file-csv text-slate-400"></i>
        <span>CSV Export</span>
      </a>

      <!-- JSON Export Button -->
      <a href="/standings/export/json<%= season ? '?seasonId=' + season.id : '' %>" class="px-3.5 py-2 rounded-xl bg-white/10 border border-white/15 hover:bg-white/15 text-xs font-mono text-slate-300 hover:text-white transition-all flex items-center gap-1.5 shadow-sm">
        <i class="fas fa-code text-slate-400"></i>
        <span>JSON</span>
      </a>
    </div>
  </div>

  <div class="space-y-10">
    
    <!-- 1. FAHRER-WELTMEISTERSCHAFT -->
    <div class="bg-slate-900/60 backdrop-blur-xl border border-white/10 rounded-2xl overflow-hidden shadow-2xl">
      <div class="p-5 sm:p-6 border-b border-white/10 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-3 h-3 rounded-full bg-[#DE382B]"></div>
          <h2 class="text-lg font-bold text-white uppercase tracking-wide flex items-center gap-2">
            <span>🏆 Fahrer-Weltmeisterschaft</span>
          </h2>
        </div>
        <span class="text-xs font-mono text-slate-400">
          <%= driverStandings.length %> gewertete Fahrer
        </span>
      </div>

      <% if (driverStandings.length === 0) { %>
        <div class="p-8 text-center text-xs text-slate-400">
          Bisher wurden noch keine Rennergebnisse für diese Saison erfasst.
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-950/80 text-slate-400 font-mono uppercase text-[10px] tracking-wider border-b border-white/5">
              <tr>
                <th class="px-4 py-3.5 text-center w-12">Pos</th>
                <th class="px-4 py-3.5">Fahrer</th>
                <th class="px-4 py-3.5">Team</th>
                <th class="px-4 py-3.5 text-center">Siege</th>
                <th class="px-4 py-3.5 text-center">Podien</th>
                <th class="px-4 py-3.5 text-center">Fastest Laps</th>
                <th class="px-4 py-3.5 text-center">Rennen</th>
                <th class="px-4 py-3.5 text-right font-bold text-white">Punkte</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <% driverStandings.forEach((d) => { %>
                <tr class="hover:bg-white/[0.03] transition-colors">
                  <!-- Pos -->
                  <td class="px-4 py-3.5 text-center font-mono font-bold text-sm <%= d.position === 1 ? 'text-amber-400' : d.position === 2 ? 'text-slate-200' : d.position === 3 ? 'text-amber-600' : 'text-slate-400' %>">
                    <%= d.position %>
                  </td>

                  <!-- Driver & Number -->
                  <td class="px-4 py-3.5">
                    <div class="flex items-center gap-2.5">
                      <!-- Team Farbstreifen -->
                      <div class="w-1 h-6 rounded-full flex-shrink-0" style="background-color: <%= d.teamColorHex %>;"></div>

                      <% if (d.raceNumber) { %>
                        <span class="font-mono font-bold text-[11px] px-1.5 py-0.5 rounded bg-black/40 border border-white/10 text-slate-300">
                          #<%= d.raceNumber %>
                        </span>
                      <% } %>
                      <span class="font-semibold text-white text-sm">
                        <%= d.driverName %>
                      </span>
                      <% if (d.penaltyPoints && d.penaltyPoints > 0) { %>
                        <span class="px-1.5 py-0.5 rounded bg-rose-950/40 border border-rose-500/30 text-[9px] font-mono text-rose-300" title="Lizenz-Strafpunkte">
                          <%= d.penaltyPoints %> LP
                        </span>
                      <% } %>
                      <% if (d.warningsCount && d.warningsCount > 0) { %>
                        <span class="px-1.5 py-0.5 rounded bg-amber-950/40 border border-amber-500/30 text-[9px] font-mono text-amber-300" title="Verwarnungen">
                          <%= d.warningsCount %> VW
                        </span>
                      <% } %>
                    </div>
                  </td>

                  <!-- Team -->
                  <td class="px-4 py-3.5 text-slate-300">
                    <span class="inline-block" style="color: <%= d.teamColorHex %>;">■</span>
                    <%= d.teamName %>
                  </td>

                  <!-- Stats -->
                  <td class="px-4 py-3.5 text-center font-mono text-slate-300 tabular-nums"><%= d.wins %></td>
                  <td class="px-4 py-3.5 text-center font-mono text-slate-300 tabular-nums"><%= d.podiums %></td>
                  <td class="px-4 py-3.5 text-center font-mono text-purple-400 tabular-nums"><%= d.fastestLaps %></td>
                  <td class="px-4 py-3.5 text-center font-mono text-slate-400 tabular-nums"><%= d.racesCount %></td>

                  <!-- Points -->
                  <td class="px-4 py-3.5 text-right font-mono font-extrabold text-base text-white tabular-nums">
                    <%= d.points %> <span class="text-[10px] text-slate-400 font-normal">PTS</span>
                    <% if (d.pointAdjustments && d.pointAdjustments !== 0) { %>
                      <div class="text-[9px] font-mono text-slate-400 font-normal">
                        <%= d.pointAdjustments > 0 ? '+' : '' %><%= d.pointAdjustments %> Pen
                      </div>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- 2. KONSTRUKTEURS-WELTMEISTERSCHAFT -->
    <div class="bg-slate-900/60 backdrop-blur-xl border border-white/10 rounded-2xl overflow-hidden shadow-2xl">
      <div class="p-5 sm:p-6 border-b border-white/10 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-3 h-3 rounded-full bg-cyan-400"></div>
          <h2 class="text-lg font-bold text-white uppercase tracking-wide flex items-center gap-2">
            <span>🏎️ Konstrukteurs-Weltmeisterschaft</span>
          </h2>
        </div>
        <span class="text-xs font-mono text-slate-400">
          <%= teamStandings.length %> Teams
        </span>
      </div>

      <% if (teamStandings.length === 0) { %>
        <div class="p-8 text-center text-xs text-slate-400">
          Noch keine Punkte in der Konstrukteurswertung.
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-950/80 text-slate-400 font-mono uppercase text-[10px] tracking-wider border-b border-white/5">
              <tr>
                <th class="px-4 py-3.5 text-center w-12">Pos</th>
                <th class="px-4 py-3.5">Kürzel</th>
                <th class="px-4 py-3.5">Team</th>
                <th class="px-4 py-3.5 text-center">Siege</th>
                <th class="px-4 py-3.5 text-center">Podien</th>
                <th class="px-4 py-3.5 text-right font-bold text-white">Punkte</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <% teamStandings.forEach((t) => { %>
                <tr class="hover:bg-white/[0.03] transition-colors">
                  <td class="px-4 py-3.5 text-center font-mono font-bold text-sm <%= t.position === 1 ? 'text-amber-400' : t.position === 2 ? 'text-slate-200' : t.position === 3 ? 'text-amber-600' : 'text-slate-400' %>">
                    <%= t.position %>
                  </td>
                  <td class="px-4 py-3.5 font-mono font-bold">
                    <span class="px-2.5 py-1 rounded-full text-[11px] font-mono font-black" style="background-color: <%= t.colorHex %>20; color: <%= t.colorHex %>; border: 1px solid <%= t.colorHex %>40;">
                      <%= t.shortCode %>
                    </span>
                  </td>
                  <td class="px-4 py-3.5 font-semibold text-white">
                    <div class="flex items-center gap-3">
                      <div class="w-1.5 h-6 rounded-full flex-shrink-0" style="background-color: <%= t.colorHex %>;"></div>
                      <% if (t.logoUrl && t.logoUrl.startsWith('<svg')) { %>
                        <div class="w-8 h-6 flex items-center justify-center p-0.5 flex-shrink-0" style="color: <%= t.colorHex %>;">
                          <%- t.logoUrl %>
                        </div>
                      <% } %>
                      <span><%= t.teamName %></span>
                    </div>
                  </td>
                  <td class="px-4 py-3.5 text-center font-mono text-slate-300 tabular-nums"><%= t.wins %></td>
                  <td class="px-4 py-3.5 text-center font-mono text-slate-300 tabular-nums"><%= t.podiums %></td>
                  <td class="px-4 py-3.5 text-right font-mono font-extrabold text-base text-white tabular-nums">
                    <%= t.points %> <span class="text-[10px] text-slate-400 font-normal">PTS</span>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
