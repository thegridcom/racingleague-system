<footer class="mt-auto rounded-t-[32px] sm:rounded-t-[40px] bg-slate-900/80 backdrop-blur-xl border-t border-white/10 text-slate-400 text-xs shadow-2xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-8">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-10">
      
      <!-- Logo, Claim & Social Links (thegridcom.org Style) -->
      <div class="md:col-span-5">
        <div class="flex items-center gap-3 mb-3">
          <img src="/images/grid-racing-logo.jpg" alt="the grid. racing league" class="w-9 h-9 rounded-full object-cover border border-white/15">
          <div class="flex items-baseline">
            <span class="font-extrabold text-white text-lg tracking-tight">the&nbsp;<span class="text-[#DE382B]">grid.</span></span>
            <span class="ml-1.5 text-[10px] uppercase font-mono tracking-widest text-slate-400 font-semibold">racing league</span>
          </div>
        </div>
        
        <p class="text-slate-400 leading-relaxed text-xs max-w-sm mb-5">
          Die motorsportliche Simracing-Community im thegridcom.org Universum. Faire Rad-an-Rad-Duelle, transparente Meisterschaftswertung und sauberer Rennsport.
        </p>

        <!-- Social Icons wie in thegridcom.org -->
        <div class="flex items-center gap-2.5 mb-5">
          <a href="https://discord.gg/XXs7AgWruv" target="_blank" rel="noopener noreferrer" title="Discord Community" class="w-9 h-9 rounded-full bg-white/[0.04] border border-white/10 flex items-center justify-center text-slate-300 hover:text-white hover:bg-[#5865F2] hover:border-[#5865F2] hover:-translate-y-0.5 transition-all">
            <i class="fab fa-discord text-sm"></i>
          </a>
          <a href="https://thegridcom.org" target="_blank" rel="noopener noreferrer" title="thegridcom.org Hauptseite" class="w-9 h-9 rounded-full bg-white/[0.04] border border-white/10 flex items-center justify-center text-slate-300 hover:text-white hover:bg-[#DE382B] hover:border-[#DE382B] hover:-translate-y-0.5 transition-all">
            <i class="fas fa-globe text-sm"></i>
          </a>
          <a href="https://twitch.tv/thegridcom" target="_blank" rel="noopener noreferrer" title="Twitch" class="w-9 h-9 rounded-full bg-white/[0.04] border border-white/10 flex items-center justify-center text-slate-300 hover:text-white hover:bg-[#9146FF] hover:border-[#9146FF] hover:-translate-y-0.5 transition-all">
            <i class="fab fa-twitch text-sm"></i>
          </a>
          <a href="https://tiktok.com/@thegridcom" target="_blank" rel="noopener noreferrer" title="TikTok" class="w-9 h-9 rounded-full bg-white/[0.04] border border-white/10 flex items-center justify-center text-slate-300 hover:text-white hover:bg-black hover:border-white/30 hover:-translate-y-0.5 transition-all">
            <i class="fab fa-tiktok text-sm"></i>
          </a>
        </div>
        
        <!-- thegridcom.org Netzwerk-Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/[0.03] border border-white/10 text-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-[#f97316] animate-pulse"></span>
          <span>Teil des Netzwerks: <a href="https://thegridcom.org" target="_blank" rel="noopener noreferrer" class="text-white hover:text-[#f97316] underline font-semibold transition-colors">thegridcom.org</a></span>
        </div>
      </div>

      <!-- Quicklinks -->
      <div class="md:col-span-3">
        <div class="font-mono text-xs uppercase font-bold text-white tracking-wider mb-4 flex items-center gap-2">
          <i class="fas fa-flag-checkered text-[#DE382B]"></i> Navigation
        </div>
        <ul class="space-y-2.5 text-xs">
          <li><a href="/calendar" class="text-slate-400 hover:text-white transition-colors flex items-center gap-1.5"><span class="text-slate-600">›</span> Rennkalender &amp; Strecken</a></li>
          <li><a href="/standings" class="text-slate-400 hover:text-white transition-colors flex items-center gap-1.5"><span class="text-slate-600">›</span> Fahrer- &amp; Teamwertung</a></li>
          <li><a href="/driver/roster" class="text-slate-400 hover:text-white transition-colors flex items-center gap-1.5"><span class="text-slate-600">›</span> Offizielles Fahrerfeld</a></li>
          <li><a href="/driver/dashboard" class="text-slate-400 hover:text-white transition-colors flex items-center gap-1.5"><span class="text-slate-600">›</span> Fahrer-Cockpit</a></li>
          <li><a href="https://thegridcom.org" target="_blank" rel="noopener noreferrer" class="text-[#f97316] hover:underline transition-colors flex items-center gap-1.5 font-medium"><i class="fas fa-external-link-alt text-[10px]"></i> thegridcom.org Portal</a></li>
        </ul>
      </div>

      <!-- Rechtliches & DSGVO -->
      <div class="md:col-span-4">
        <div class="font-mono text-xs uppercase font-bold text-white tracking-wider mb-4 flex items-center gap-2">
          <i class="fas fa-scale-balanced text-slate-400"></i> Rechtliches &amp; Privatsphäre
        </div>
        <ul class="space-y-2.5 text-xs mb-4">
          <li><a href="/impressum" class="text-slate-400 hover:text-white transition-colors flex items-center gap-1.5"><span class="text-slate-600">›</span> Impressum (Angaben gem. § 5 DDG)</a></li>
          <li><a href="/datenschutz" class="text-slate-400 hover:text-white transition-colors flex items-center gap-1.5"><span class="text-slate-600">›</span> Datenschutzerklärung (DSGVO Art. 13 ff.)</a></li>
          <li class="text-[11px] text-slate-400 flex items-center gap-1.5"><span class="text-emerald-400">✓</span> 100% tracker-frei &amp; cookie-banner-frei</li>
          <li class="text-[11px] text-slate-400 flex items-center gap-1.5"><span class="text-cyan-400">✓</span> DSGVO Art. 17 Account-Löschung im Dashboard</li>
        </ul>
      </div>
    </div>

    <!-- Markenrechtlicher Pflicht-Disclaimer im Glassmorphism-Kasten -->
    <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/5 text-[11px] leading-relaxed text-slate-400 mb-6">
      <p class="font-semibold text-slate-300 mb-1 flex items-center gap-1.5">
        <i class="fas fa-circle-info text-slate-400"></i> Rechtlicher Hinweis &amp; Markenrechtlicher Disclaimer:
      </p>
      <p class="italic text-slate-400">
        "<%= locals.disclaimer %>"
      </p>
    </div>

    <!-- Copyright & Bottom Line -->
    <div class="pt-4 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between text-[11px] text-slate-400 gap-3">
      <div>&copy; <%= locals.year %> the grid. - racing league. Ein privates Projekt von <a href="https://thegridcom.org" target="_blank" rel="noopener noreferrer" class="hover:text-white underline text-slate-300 font-medium">thegridcom.org</a>.</div>
      <div class="font-mono text-[10px] text-slate-400 flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>Private Simracing Community</span>
      </div>
    </div>

  </div>
</footer>
