<!DOCTYPE html>
<html lang="de" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'the grid. - racing league' %></title>
  <link rel="icon" type="image/jpeg" href="/images/grid-racing-logo.jpg">
  
  <!-- Fonts (Inter & Space Grotesk wie thegridcom.org) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@600;700;800&display=swap" rel="stylesheet">
  
  <!-- FontAwesome (verwendet von thegridcom.org für Icons) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            grid: {
              bg: '#0f172a',
              surface: '#1e293b',
              card: 'rgba(30, 41, 59, 0.7)',
              accent: '#DE382B',
              accentHover: '#C52B1F',
              discord: '#5865F2',
              discordHover: '#4752C4',
              muted: '#94a3b8',
              border: 'rgba(255, 255, 255, 0.08)',
            },
            racing: {
              red: '#DE382B',
              redHover: '#C52B1F',
              carbon: '#0f172a',
              border: 'rgba(255, 255, 255, 0.08)',
            }
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            display: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          }
        }
      }
    }
  </script>

  <style>
    /* thegridcom.org CSS Custom Properties */
    :root {
      --bg-color: #0f172a;
      --surface-color: rgba(30, 41, 59, 0.7);
      --accent-color: #DE382B;
      --accent-hover: #C52B1F;
      --glass-bg: rgba(255, 255, 255, 0.04);
      --glass-border: rgba(255, 255, 255, 0.08);
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --discord-color: #5865F2;
      --discord-hover: #4752C4;
      --box-shadow-depth: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      --glow-accent: 0 10px 25px rgba(222, 56, 43, 0.25);
      --glow-discord: 0 10px 25px rgba(88, 101, 242, 0.25);
      --transition-smooth: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    body {
      background-color: #0f172a;
      background-image: 
        radial-gradient(circle at 12% 18%, rgba(222, 56, 43, 0.12), transparent 42%),
        radial-gradient(circle at 88% 75%, rgba(56, 189, 248, 0.08), transparent 42%);
      background-attachment: fixed;
      color: #f8fafc;
      font-family: 'Inter', sans-serif;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    
    /* Monospace-Ziffern für Tabellen und Timing Tower */
    .tabular-nums {
      font-variant-numeric: tabular-nums;
    }

    /* Glassmorphism Utilities aus thegridcom.org */
    .glassmorphism {
      background: rgba(30, 41, 59, 0.65);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .glassmorphism-card {
      background: rgba(30, 41, 59, 0.65);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 18px;
      box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.4);
      transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    .glassmorphism-card:hover {
      border-color: rgba(255, 255, 255, 0.16);
      transform: translateY(-3px);
      box-shadow: 0 25px 50px -10px rgba(0, 0, 0, 0.6);
    }

    /* thegridcom.org Badge Style */
    .grid-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.4rem 0.9rem;
      border-radius: 100px;
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--accent-color);
      background: rgba(255, 255, 255, 0.04);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(222, 56, 43, 0.25);
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #0f172a;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.12);
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #DE382B;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col font-sans bg-[#0f172a] text-[#f8fafc] selection:bg-[#DE382B] selection:text-white">
