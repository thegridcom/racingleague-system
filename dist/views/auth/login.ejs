<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<main class="flex-grow flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8 relative">
  <div class="max-w-md w-full bg-slate-900/70 backdrop-blur-2xl border border-white/10 rounded-3xl p-8 sm:p-10 relative overflow-hidden shadow-2xl">
    
    <!-- Ambient Accent Glow -->
    <div class="absolute -top-24 -left-24 w-48 h-48 bg-[#DE382B]/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-48 h-48 bg-[#5865F2]/15 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Header -->
    <div class="text-center mb-8 relative">
      <div class="w-14 h-14 rounded-2xl bg-white/[0.04] border border-white/10 flex items-center justify-center mx-auto mb-4 text-[#DE382B] shadow-inner">
        <i class="fab fa-discord text-2xl text-[#5865F2]"></i>
      </div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 text-[11px] font-semibold text-slate-300 mb-2.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Rennleitung &amp; Fahrerportal</span>
      </div>
      <h2 class="text-2xl font-bold text-white tracking-tight">Fahrer-Login</h2>
      <p class="text-xs text-slate-400 mt-2 leading-relaxed">
        Authentifiziere dich über deinen verifizierten Discord-Account, um Zugang zu deinem Cockpit und der Startaufstellung zu erhalten.
      </p>
    </div>

    <!-- Discord OAuth2 Button -->
    <div class="space-y-4 relative">
      <a href="/auth/discord" class="w-full flex items-center justify-center gap-3 px-6 py-3.5 rounded-full bg-[#5865F2] hover:bg-[#4752C4] text-white font-semibold text-sm transition-all shadow-lg shadow-indigo-950/50 hover:shadow-indigo-900/60 active:scale-[0.98]">
        <i class="fab fa-discord text-lg"></i>
        <span>Mit Discord anmelden</span>
      </a>

      <!-- Rollen- & Registrierungshinweis -->
      <div class="p-3.5 rounded-2xl bg-slate-950/60 border border-white/10 text-[11px] text-slate-400 leading-relaxed flex items-start gap-2.5">
        <i class="fas fa-id-badge text-amber-400 mt-0.5 text-xs flex-shrink-0"></i>
        <div>
          <strong class="text-slate-200 block mb-0.5 font-medium">Zugangsbeschränkung:</strong>
          Nur Fahrer mit der offiziellen <span class="text-white font-semibold">Fahrer-Rolle</span> auf unserem Discord-Server oder Mitglieder der Rennleitung können einen Account anlegen.
        </div>
      </div>

      <!-- DSGVO Datensparsamkeit -->
      <div class="p-3 rounded-2xl bg-white/[0.02] border border-white/5 text-[10px] text-slate-500 leading-relaxed flex items-center gap-2">
        <i class="fas fa-shield-halved text-slate-400 text-xs flex-shrink-0"></i>
        <span>DSGVO-Datensparsamkeit: Es werden nur minimale Identifikations-Scopes abgefragt. Keine unnötigen Daten.</span>
      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
